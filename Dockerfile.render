FROM node:24-bookworm-slim AS frontend

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV API_INTERNAL_URL=http://127.0.0.1:8000 \
    NEXT_PUBLIC_API_URL=/api \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM ghcr.io/astral-sh/uv:latest AS uv

FROM python:3.12-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --create-home app

WORKDIR /app/backend
ENV PATH="/app/backend/.venv/bin:$PATH" \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --no-cache
COPY backend/app ./app
COPY backend/scripts ./scripts
COPY data /app/data

COPY --from=frontend --chown=app:app /app/frontend/.next/standalone /app/frontend
COPY --from=frontend --chown=app:app /app/frontend/.next/static /app/frontend/.next/static
COPY --from=frontend --chown=app:app /app/frontend/public /app/frontend/public
COPY docker/start-render.sh /app/start-render.sh

USER app
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "/app/start-render.sh"]
