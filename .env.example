# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# 영상의 음성 인식(Whisper API)에 쓴다. 없으면 음성 인식만 건너뛰고 자막과 화면 글자로 판별한다.
OPENAI_API_KEY=

# 아래는 기본값이 있어 바꿀 때만 적는다.
# DATABASE_URL=postgresql://heresy:heresy@localhost:5432/heresy
# CORS_EXTENSION_IDS=["<chrome://extensions에서 확인한 32자리 ID>"]
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=high
# EMBEDDING_MODEL=voyage-4
# STT_MODEL=whisper-1
# OCR_MODEL=claude-haiku-5-5

# GPU가 있는 컴퓨터에서 음성·화면 글자 인식을 직접 돌릴 때 (backend 에서 uv sync --extra local 필요)
# STT_BACKEND=local
# OCR_BACKEND=local
# LOCAL_DEVICE=cuda
